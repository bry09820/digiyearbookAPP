# ---------------------------------------------------------------------------
# Local development (Metro / Expo Go / emulator)
# ---------------------------------------------------------------------------
# Physical device: use your PC's LAN IP (same Wi‑Fi as the phone).
# Laravel must bind to all interfaces:
#   php artisan serve --host=0.0.0.0 --port=8000
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000/api
EXPO_PUBLIC_AUTH_BASE_URL=http://192.168.x.x:8000

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# EXPO_PUBLIC_AUTH_BASE_URL=http://10.0.2.2:8000

# ---------------------------------------------------------------------------
# Production / EAS APK builds (required)
# ---------------------------------------------------------------------------
# Set these as EAS secrets or pass via `eas build --profile production --env-file .env.production`
# EXPO_PUBLIC_API_URL=https://your-api.example.com/api
# EXPO_PUBLIC_AUTH_BASE_URL=https://your-api.example.com
# EXPO_PUBLIC_BILLING_URL=https://your-api.example.com/billing

# Companion Alumni Tracker deep link (or https URL). Yearbook return scheme: capstoneapp://
EXPO_PUBLIC_ALUMNI_TRACKER_URL=alumnitracker://home
EXPO_PUBLIC_YEARBOOK_RETURN_URL=capstoneapp://(tabs)/home

# PayMongo / billing portal (web). Used when Laravel checkout endpoints are unavailable.
# EXPO_PUBLIC_BILLING_URL=http://192.168.x.x:8000/billing
# EXPO_PUBLIC_SUBSCRIPTION_RETURN_URL=capstoneapp://subscription/callback
